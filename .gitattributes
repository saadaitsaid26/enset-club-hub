# Normalize line endings
* text=auto

# Source code
*.php text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries / images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
